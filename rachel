"""
PROGRAM RAWAT INAP (OPNAME) RUMAH SAKIT
Materi: operator pembanding (==, !=, <, >, <=, >=) dan kondisional (if/elif/else)
Alur: data pasien -> pilih jenis opname (10 jenis) -> lama inap -> biaya -> struk
"""

# 10 jenis opname: kode -> (nama kamar, tarif per hari, fasilitas)
KAMAR = {
    1: ("Kelas 3 (Bangsal 6 bed)", 150000,
        "Kasur standar, kipas angin, kamar mandi bersama, makan 3x"),
    2: ("Kelas 2 (2-4 bed)", 300000,
        "Kasur standar, AC, kamar mandi dalam, TV bersama, makan 3x"),
    3: ("Kelas 1 (2 bed)", 500000,
        "Kasur elektrik, AC, kamar mandi dalam, TV, lemari es mini, makan 3x"),
    4: ("VIP", 900000,
        "1 pasien, AC, TV LED, sofa penunggu, kulkas, air panas, makan 3x + snack"),
    5: ("VVIP / Suite", 1500000,
        "Kamar luas, ruang tamu, TV, pantry, WiFi, kamar mandi mewah, menu pilihan"),
    6: ("ICU", 2500000,
        "Monitor 24 jam, ventilator, perawat khusus 1:1, dokter jaga intensif"),
    7: ("NICU (bayi baru lahir)", 2000000,
        "Inkubator, monitor bayi, perawat neonatal, fototerapi"),
    8: ("HCU (High Care)", 1800000,
        "Monitor vital sign, perawat siaga, oksigen sentral, dokter visit harian"),
    9: ("Ruang Isolasi", 1200000,
        "Kamar tekanan negatif, APD petugas, kamar mandi dalam, makan 3x"),
    10: ("Ruang Bersalin / Nifas", 700000,
        "Kamar nifas, AC, kamar mandi dalam, perawatan bayi, makan 3x"),
}

BIAYA_ADMIN = 50000
BIAYA_VISIT_DOKTER_PER_HARI = 100000


def tampilkan_daftar():
    print("\n" + "=" * 78)
    print("                       DAFTAR JENIS RAWAT INAP")
    print("=" * 78)
    for kode, (nama, tarif, fasilitas) in KAMAR.items():
        print(f"[{kode:>2}] {nama:<26} Rp {tarif:>9,}/hari")
        print(f"     Fasilitas: {fasilitas}")
    print("=" * 78)


def hitung_diskon_lama_inap(hari):
    """Diskon berdasarkan lama inap (operator pembanding)."""
    if hari >= 7:
        return 0.10  # 10%
    elif hari >= 3:
        return 0.05  # 5%
    else:
        return 0.0


def hitung_subsidi(status, kode_kamar):
    """
    Status pasien:
    1 = Umum, 2 = BPJS, 3 = Asuransi swasta
    BPJS hanya menanggung kamar Kelas 1-3 (kode 1-3).
    """
    if status == 2 and kode_kamar <= 3:
        return 0.80  # BPJS tanggung 80% biaya kamar
    elif status == 3:
        return 0.50  # Asuransi swasta tanggung 50%
    else:
        return 0.0


def cetak_struk(data):
    print("\n" + "=" * 56)
    print("          STRUK RAWAT INAP - RS SEHAT SENTOSA")
    print("=" * 56)
    print(f"Nama Pasien     : {data['nama']}")
    print(f"Umur            : {data['umur']} tahun ({data['kategori']})")
    print(f"Status Pasien   : {data['status']}")
    print(f"Jenis Opname    : {data['kamar']}")
    print(f"Lama Inap       : {data['hari']} hari")
    print(f"Fasilitas       : {data['fasilitas']}")
    print("-" * 56)
    print(f"{'Biaya kamar (' + str(data['hari']) + ' x ' + format(data['tarif'], ',') + ')':<38}{data['biaya_kamar']:>18,.0f}")
    print(f"{'Visit dokter (' + str(data['hari']) + ' x ' + format(BIAYA_VISIT_DOKTER_PER_HARI, ',') + ')':<38}{data['biaya_visit']:>18,.0f}")
    print(f"{'Biaya administrasi':<38}{BIAYA_ADMIN:>18,.0f}")
    print(f"{'Subtotal':<38}{data['subtotal']:>18,.0f}")
    print(f"{'Diskon lama inap (' + str(int(data['p_diskon'] * 100)) + '%)':<38}{-data['diskon']:>18,.0f}")
    print(f"{'Diskon usia (' + str(int(data['p_usia'] * 100)) + '%)':<38}{-data['diskon_usia']:>18,.0f}")
    print(f"{'Ditanggung penjamin (' + str(int(data['p_subsidi'] * 100)) + '%)':<38}{-data['subsidi']:>18,.0f}")
    print("-" * 56)
    print(f"{'TOTAL YANG HARUS DIBAYAR':<38}{data['total']:>18,.0f}")
    print(f"{'Uang bayar':<38}{data['bayar']:>18,.0f}")
    print(f"{'Kembalian':<38}{data['kembalian']:>18,.0f}")
    print("=" * 56)
    print("        Semoga lekas sembuh. Terima kasih!")
    print("=" * 56)


def main():
    print("=== PENDAFTARAN RAWAT INAP ===")
    nama = input("Nama pasien : ").strip() or "Tanpa Nama"

    while True:
        try:
            umur = int(input("Umur pasien : "))
            if umur < 0 or umur > 120:
                print(">> Umur tidak valid!")
                continue
            break
        except ValueError:
            print(">> Input harus angka!")

    # Kategori usia (kondisional)
    if umur < 12:
        kategori = "Anak"
    elif umur < 18:
        kategori = "Remaja"
    elif umur < 60:
        kategori = "Dewasa"
    else:
        kategori = "Lansia"

    # Diskon usia: anak & lansia
    if kategori == "Anak" or kategori == "Lansia":
        p_usia = 0.05
    else:
        p_usia = 0.0

    # Status pasien
    print("\nStatus pasien: 1.Umum  2.BPJS  3.Asuransi Swasta")
    while True:
        try:
            status = int(input("Pilih status (1-3): "))
        except ValueError:
            print(">> Input harus angka!")
            continue
        if status in (1, 2, 3):
            break
        print(">> Pilihan tidak valid!")
    nama_status = {1: "Umum", 2: "BPJS", 3: "Asuransi Swasta"}[status]

    # Pilih jenis opname
    tampilkan_daftar()
    while True:
        try:
            kode = int(input("Pilih jenis opname (1-10): "))
        except ValueError:
            print(">> Input harus angka!")
            continue
        if kode >= 1 and kode <= 10:
            break
        print(">> Kode tidak ada!")

    # Peringatan kondisional
    if status == 2 and kode > 3:
        print(">> Info: BPJS hanya menanggung Kelas 1-3. Biaya ditanggung sendiri.")
    if kategori == "Anak" and kode == 6:
        print(">> Catatan: Anak di ICU, disarankan NICU/PICU sesuai kondisi.")

    # Lama inap
    while True:
        try:
            hari = int(input("Lama inap (hari): "))
        except ValueError:
            print(">> Input harus angka!")
            continue
        if hari > 0:
            break
        print(">> Lama inap minimal 1 hari!")

    nama_kamar, tarif, fasilitas = KAMAR[kode]

    # Perhitungan
    biaya_kamar = tarif * hari
    biaya_visit = BIAYA_VISIT_DOKTER_PER_HARI * hari
    subtotal = biaya_kamar + biaya_visit + BIAYA_ADMIN

    p_diskon = hitung_diskon_lama_inap(hari)
    diskon = subtotal * p_diskon
    diskon_usia = (subtotal - diskon) * p_usia

    setelah_diskon = subtotal - diskon - diskon_usia
    p_subsidi = hitung_subsidi(status, kode)
    subsidi = setelah_diskon * p_subsidi
    total = setelah_diskon - subsidi

    print(f"\nTotal yang harus dibayar: Rp {total:,.0f}")
    while True:
        try:
            bayar = float(input("Uang bayar: Rp "))
        except ValueError:
            print(">> Input harus angka!")
            continue
        if bayar >= total:
            break
        print(f">> Uang kurang Rp {total - bayar:,.0f}. Ulangi.")

    data = {
        "nama": nama, "umur": umur, "kategori": kategori,
        "status": nama_status, "kamar": nama_kamar, "hari": hari,
        "fasilitas": fasilitas, "tarif": tarif,
        "biaya_kamar": biaya_kamar, "biaya_visit": biaya_visit,
        "subtotal": subtotal, "p_diskon": p_diskon, "diskon": diskon,
        "p_usia": p_usia, "diskon_usia": diskon_usia,
        "p_subsidi": p_subsidi, "subsidi": subsidi,
        "total": total, "bayar": bayar, "kembalian": bayar - total,
    }
    cetak_struk(data)


if __name__ == "__main__":
    main()